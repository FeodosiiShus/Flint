[
  {
    "bindings": {
      "cmd-{": "pane::ActivatePreviousItem",
      "cmd-}": "pane::ActivateNextItem",
      "shift-escape": null, // Unmap workspace::zoom
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl->": ["zed::IncreaseBufferFontSize", { "persist": true }],
      "ctrl-<": ["zed::DecreaseBufferFontSize", { "persist": true }],
      "ctrl-shift-j": "editor::JoinLines",
      "cmd-d": "editor::DuplicateSelection",
      "cmd-backspace": "editor::DeleteLine",
      "cmd-pagedown": "editor::MovePageDown",
      "cmd-pageup": "editor::MovePageUp",
      "ctrl-alt-shift-b": "editor::SelectToPreviousWordStart",
      "cmd-alt-enter": "editor::NewlineAbove",
      "shift-enter": "editor::NewlineBelow",
      "cmd--": "editor::Fold",
      "cmd-+": "editor::UnfoldLines",
      "alt-shift-g": "editor::SplitSelectionIntoLines",
      "ctrl-g": ["editor::SelectNext", { "replace_newest": false }],
      "ctrl-shift-g": "editor::UndoSelection",
      "ctrl-cmd-g": ["editor::SelectPrevious", { "replace_newest": false }],
      "cmd-/": ["editor::ToggleComments", { "advance_downwards": true, "comment_empty_lines": true }],
      "alt-up": "editor::SelectLargerSyntaxNode",
      "alt-down": "editor::SelectSmallerSyntaxNode",
      "shift-alt-up": "editor::MoveLineUp",
      "shift-alt-down": "editor::MoveLineDown",
      "cmd-alt-l": "editor::Format",
      "ctrl-alt-o": "editor::OrganizeImports",
      "shift-f6": "editor::Rename",
      "cmd-[": "pane::GoBack",
      "cmd-]": "pane::GoForward",
      "alt-f7": "editor::FindAllReferences",
      "cmd-alt-f7": "editor::ShowUsages",
      "cmd-alt-shift-f7": "show_usages::ShowSettings",
      "cmd-b": "editor::GoToDefinition", // Conflicts with workspace::ToggleLeftDock
      "cmd-alt-b": "editor::GoToImplementation",
      "cmd-shift-b": "editor::GoToTypeDefinition",
      "cmd-alt-shift-b": "editor::GoToTypeDefinitionSplit",
      "f2": "editor::GoToNextHighlightedError",
      "shift-f2": "editor::GoToPreviousHighlightedError",
      "ctrl-alt-shift-down": "editor::GoToHunk",
      "ctrl-alt-shift-up": "editor::GoToPreviousHunk",
      "cmd-home": "editor::MoveToBeginning",
      "cmd-end": "editor::MoveToEnd",
      "cmd-shift-home": "editor::SelectToBeginning",
      "cmd-shift-end": "editor::SelectToEnd",
      "alt-left": "editor::MoveToPreviousSubwordStart",
      "alt-right": "editor::MoveToNextSubwordEnd",
      "shift-alt-left": "editor::SelectToPreviousSubwordStart",
      "shift-alt-right": "editor::SelectToNextSubwordEnd",
      "ctrl-f8": "editor::ToggleBreakpoint",
      "ctrl-shift-f8": "editor::EditLogBreakpoint",
      "cmd-shift-u": "editor::ToggleCase",
    },
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "cmd-f12": "outline::Toggle",
      "cmd-r": ["buffer_search::Deploy", { "replace_enabled": true }],
      "cmd-l": "go_to_line::Toggle",
      "cmd-e": "file_finder::Toggle",
      "cmd-shift-o": ["search_everywhere::Toggle", { "tab": "files" }],
      "cmd-shift-n": ["search_everywhere::Toggle", { "tab": "files" }],
      "alt-enter": "editor::ToggleCodeActions",
      "ctrl-space": "editor::ShowCompletions",
      "cmd-j": "editor::Hover",
      "cmd-p": "editor::ShowSignatureHelp",
    },
  },
  {
    "context": "Editor && mode == auto_height",
    "bindings": {
      "shift-enter": "editor::Newline",
      "ctrl-shift-enter": "editor::NewlineBelow",
    },
  },
  {
    "context": "BufferSearchBar",
    "bindings": {
      "shift-enter": "search::SelectPreviousMatch",
    },
  },
  {
    "context": "BufferSearchBar || ProjectSearchBar",
    "bindings": {
      "alt-c": "search::ToggleCaseSensitive",
      "alt-e": "search::ToggleSelection",
      "alt-x": "search::ToggleRegex",
      "alt-w": "search::ToggleWholeWord",
      "ctrl-alt-c": "search::ToggleCaseSensitive",
      "ctrl-alt-e": "search::ToggleSelection",
      "ctrl-alt-w": "search::ToggleWholeWord",
      "ctrl-alt-x": "search::ToggleRegex",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-f12": "workspace::ToggleAllDocks",
      "cmd-shift-r": ["pane::DeploySearch", { "replace_enabled": true }],
      "cmd-e": "file_finder::Toggle",
      "cmd-k": "git::Commit",
      "cmd-t": "git::UpdateProject",
      "cmd-alt-n": "git::NewBranch",
      "cmd-shift-o": ["search_everywhere::Toggle", { "tab": "files" }],
      "cmd-shift-n": ["search_everywhere::Toggle", { "tab": "files" }],
      "cmd-n": "project_symbols::Toggle",
      "cmd-shift-a": ["search_everywhere::Toggle", { "tab": "actions" }],
      "shift shift": "search_everywhere::Toggle",
      "cmd-alt-o": ["search_everywhere::Toggle", { "tab": "symbols" }], // JetBrains: Go to Symbol
      "cmd-o": ["search_everywhere::Toggle", { "tab": "classes" }], // JetBrains: Go to Class
      "cmd-1": "project_panel::ToggleFocus",
      "cmd-3": "search_panel::ToggleFocus",
      "cmd-6": "diagnostics::Deploy",
      "cmd-9": "git_panel::ToggleFocus",
    },
  },
  {
    "context": "Pane", // this is to override the default Pane mappings to switch tabs
    "bindings": {
      "cmd-1": "project_panel::ToggleFocus",
      "cmd-2": null, // Bookmarks (left dock)
      "cmd-3": "search_panel::ToggleFocus",
      "cmd-4": null, // Run Panel (bottom dock)
      "cmd-6": "diagnostics::Deploy",
      "cmd-7": null,
      "cmd-8": null, // Services (bottom dock)
      "cmd-9": "git_panel::ToggleFocus", // Git History (bottom dock)
    },
  },
  {
    "context": "Workspace || Editor",
    "bindings": {
      "alt-f12": "terminal_panel::Toggle",
      "cmd-shift-k": "git::PushDialog",
    },
  },
  {
    "context": "Pane",
    "bindings": {
      "cmd-alt-left": "pane::GoBack",
      "cmd-alt-right": "pane::GoForward",
      "alt-left": "pane::ActivatePreviousItem",
      "alt-right": "pane::ActivateNextItem",
    },
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "enter": "project_panel::Open",
      "cmd-shift-f": "project_panel::NewSearchInDirectory",
      "cmd-backspace": ["project_panel::Trash", { "skip_prompt": false }],
      "backspace": ["project_panel::Trash", { "skip_prompt": false }],
      "delete": ["project_panel::Trash", { "skip_prompt": false }],
      "shift-delete": ["project_panel::Delete", { "skip_prompt": false }],
      "shift-f6": "project_panel::Rename",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "cmd-t": "workspace::NewTerminal",
      "cmd-n": "workspace::NewTerminal",
      "alt-f12": "workspace::CloseActiveDock",
      "cmd-up": "terminal::ScrollLineUp",
      "cmd-down": "terminal::ScrollLineDown",
      "shift-pageup": "terminal::ScrollPageUp",
      "shift-pagedown": "terminal::ScrollPageDown",
    },
  },
  { "context": "GitPanel", "bindings": { "cmd-9": "workspace::CloseActiveDock" } },
  { "context": "SearchPanel", "bindings": { "cmd-3": "workspace::CloseActiveDock" } },
  { "context": "ProjectPanel", "bindings": { "cmd-1": "workspace::CloseActiveDock" } },
  { "context": "ProjectDiagnosticsPanel", "bindings": { "cmd-6": "workspace::CloseActiveDock" } },
  {
    "context": "Dock || Workspace || ProjectPanel",
    "bindings": {
      "escape": "editor::ToggleFocus",
      "shift-escape": "workspace::CloseActiveDock",
    },
  },
  {
    "context": "Editor && mode == auto_height",
    "bindings": {
      "escape": "editor::Cancel",
    },
  },
  {
    "context": "MergeView || (MergeView > Editor)",
    "bindings": {
      "f7": "merge_tool::NextDifference",
      "shift-f7": "merge_tool::PreviousDifference",
      // WebStorm's macOS keymap binds Cmd-] / Cmd-[ to Forward / Back, not to diff navigation.
      "cmd-]": null,
      "cmd-[": null,
      "ctrl-cmd-right": "merge_tool::AcceptLeftSide",
      "ctrl-cmd-left": "merge_tool::AcceptRightSide",
      "ctrl-shift-tab": "merge_tool::FocusOppositePane",
      "cmd-enter": "merge_tool::ApplyChanges",
    },
  },
  {
    "context": "ConflictsDialog",
    "bindings": {
      "cmd-a": "merge_tool::ConflictsSelectAllRows",
      "shift-up": "merge_tool::ConflictsExtendSelectionUp",
      "shift-down": "merge_tool::ConflictsExtendSelectionDown",
      "left": "merge_tool::ConflictsCollapseRow",
      "right": "merge_tool::ConflictsExpandRow",
      "ctrl-a": "merge_tool::ConflictsSelectAllRows",
      "pageup": "merge_tool::ConflictsPageUp",
      "pagedown": "merge_tool::ConflictsPageDown",
      "shift-pageup": "merge_tool::ConflictsExtendPageUp",
      "shift-pagedown": "merge_tool::ConflictsExtendPageDown",
      "ctrl-home": "menu::SelectFirst",
      "ctrl-end": "menu::SelectLast",
      "ctrl-shift-home": "merge_tool::ConflictsExtendToFirstRow",
      "ctrl-shift-end": "merge_tool::ConflictsExtendToLastRow",
      "home": null,
      "end": null,
    },
  },
  {
    "context": "DialogWindow",
    "bindings": {
      "cmd-w": "workspace::CloseWindow",
    },
  },
  {
    "context": "GitToolWindow",
    "bindings": {
      "cmd-w": "git_tool_window::CloseActiveTab",
      "ctrl-shift-f4": "git_tool_window::CloseActiveTab",
      "ctrl-left": "git_tool_window::SelectPreviousTab",
      "ctrl-right": "git_tool_window::SelectNextTab",
      // Menus show the last binding of an action; IntelliJ lists ⇧⌘[ / ⇧⌘] first for PreviousTab / NextTab.
      "cmd-{": "git_tool_window::SelectPreviousTab",
      "cmd-}": "git_tool_window::SelectNextTab",
      "ctrl-shift-down": "git_tool_window::ShowListOfTabs",
    },
  },
  {
    "context": "GitLogBranches",
    "bindings": {
      "cmd-f": "git_log_branches::ToggleSearchFocus",
      "cmd-d": "git_log_branches::CompareWithCurrent",
      "cmd-backspace": "git_log_branches::DeleteSelected",
      "cmd-delete": "git_log_branches::DeleteSelected",
      "alt-f1": "git_log_branches::NavigateToSelectedBranch",
    },
  },
  {
    "context": "GitLogBranchesTree",
    "bindings": {
      "cmd-=": "git_log_branches::ExpandAll",
      "cmd-+": "git_log_branches::ExpandAll",
      "cmd--": "git_log_branches::CollapseAll",
    },
  },
  {
    "context": "GitLog",
    "bindings": {
      "cmd-r": "git_log_filters::Refresh",
      "cmd-f": "git_log_filters::GoToHashOrRef",
      "cmd-l": "git_log::FocusTextFilter",
    },
  },
  {
    "context": "GitLog > Editor",
    "bindings": {
      "cmd-l": "git_log::FocusTextFilter",
    },
  },
  {
    "context": "GitLogTable",
    "bindings": {
      "cmd-alt-shift-c": "git_log_table::CopyRevisionNumber",
      "cmd-c": "git_log_table::Copy",
      "cmd-a": "git_log_table::SelectAll",
      "right": "git_log_table::GoToParentCommit",
      "left": "git_log_table::GoToChildCommit",
      "cmd-d": "git_log_table::ShowDiff",
      "cmd-alt-n": "git_log_table::NewBranchFromCommit",
      "pageup": "git_log_table::SelectPageUp",
      "pagedown": "git_log_table::SelectPageDown",
      "shift-up": "git_log_table::ExtendSelectionUp",
      "shift-down": "git_log_table::ExtendSelectionDown",
      "shift-pageup": "git_log_table::ExtendSelectionPageUp",
      "shift-pagedown": "git_log_table::ExtendSelectionPageDown",
      "shift-home": "git_log_table::ExtendSelectionToFirst",
      "shift-end": "git_log_table::ExtendSelectionToLast",
    },
  },
  {
    "context": "GitLogTextFilter > Editor",
    "bindings": {
      "alt-down": "git_log_filters::ShowSearchHistory",
      "alt-up": "git_log_filters::PreviousHistoryItem",
    },
  },
  {
    "context": "GitLogFilterChip",
    "bindings": {
      "delete": "git_log_filters::ResetFilter",
      "backspace": "git_log_filters::ResetFilter",
      "cmd-backspace": "git_log_filters::ResetFilter",
    },
  },
  {
    "context": "GitLogFilterValuesPopup > Editor",
    "bindings": {
      "enter": "editor::Newline",
    },
  },
  {
    "context": "GitLogFilterValuesPopup > Editor",
    "bindings": {
      "enter": "menu::Confirm",
    },
  },
  {
    "context": "GitLogChanges",
    "bindings": {
      "cmd-d": "git_log_changes::ShowDiff",
    },
  },
  {
    "context": "GitLogChangesTree",
    "bindings": {
      "cmd-=": "git_log_changes::ExpandAll",
      "cmd-+": "git_log_changes::ExpandAll",
      "cmd--": "git_log_changes::CollapseAll",
      "ctrl-p": "git_log_changes::ToggleGroupByDirectory",
    },
  },
]
