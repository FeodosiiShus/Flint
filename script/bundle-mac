#!/usr/bin/env bash

set -euo pipefail

readonly target_triple="aarch64-apple-darwin"
readonly arch_suffix="aarch64"
readonly cargo_bundle_version_expected="cargo-bundle v0.6.1-zed"
readonly git_version="v2.43.3"
readonly git_version_sha="fa29823"
readonly entitlements_path="crates/zed/resources/zed.entitlements"

profile_args=(--release)
zed_feature_args=()
target_dir="release"
open_result=false
local_install=false

help_info() {
  echo "
Usage: ${0##*/} [options] [${target_triple}]
Build the application bundle for macOS on Apple Silicon.

Options:
  -d    Compile in debug mode
  -o    Open dir with the resulting DMG or launch the app itself in local mode.
  -i    Install the resulting app into /Applications.
  -h    Display this help and exit.
  "
}

while getopts 'doih' flag; do
  case "${flag}" in
    o) open_result=true ;;
    d)
      export CARGO_INCREMENTAL=true
      profile_args=()
      zed_feature_args=(--features util/debug-embed)
      target_dir="debug"
      ;;
    i) local_install=true ;;
    h)
      help_info
      exit 0
      ;;
    *)
      help_info >&2
      exit 1
      ;;
  esac
done

shift $((OPTIND - 1))

if [[ $# -gt 0 && -n "$1" && "$1" != "${target_triple}" ]]; then
  echo "Unsupported architecture $1; only ${target_triple} is supported" >&2
  exit 1
fi

channel="$(<crates/zed/RELEASE_CHANNEL)"
export ZED_RELEASE_CHANNEL="${channel}"
export ZED_BUNDLE=true
export CARGO_BUNDLE_SKIP_BUILD=true

cargo_bundle_version="$(cargo -q bundle --help 2>&1 | head -n 1 || echo "")"
if [[ "${cargo_bundle_version}" != "${cargo_bundle_version_expected}" ]]; then
  cargo install cargo-bundle --git https://github.com/zed-industries/cargo-bundle.git --branch zed-deploy
fi

export CXXFLAGS="-stdlib=libc++"

script/generate-licenses

rustup target add "${target_triple}"

build_dir="target/${target_triple}/${target_dir}"

echo "Compiling zed binaries"
cargo build ${profile_args[@]+"${profile_args[@]}"} ${zed_feature_args[@]+"${zed_feature_args[@]}"} --package zed --package cli --target "${target_triple}"

echo "Creating application bundle"
cp crates/zed/Cargo.toml crates/zed/Cargo.toml.backup
sed -i '' "s/package.metadata.bundle-${channel}/package.metadata.bundle/" crates/zed/Cargo.toml
app_path="$(cd crates/zed && cargo bundle ${profile_args[@]+"${profile_args[@]}"} --target "${target_triple}" --select-workspace-root | xargs)"
mv crates/zed/Cargo.toml.backup crates/zed/Cargo.toml
echo "Bundled ${app_path}"

document_icon_source="crates/zed/resources/Document.icns"
document_icon_target="${app_path}/Contents/Resources/Document.icns"
mkdir -p "$(dirname "${document_icon_target}")"
cp "${document_icon_source}" "${document_icon_target}"

download_git() {
  local target_binary="$1"
  local temp_dir
  temp_dir="$(mktemp -d)"
  curl --silent --show-error --fail --location \
    "https://github.com/desktop/dugite-native/releases/download/${git_version}/dugite-native-${git_version}-${git_version_sha}-macOS-arm64.tar.gz" \
    | tar -xz -C "${temp_dir}" -f - bin/git
  mv "${temp_dir}/bin/git" "${target_binary}"
  rm -rf "${temp_dir}"
}

if [[ "${target_dir}" == "release" && "${local_install}" != true ]]; then
  strip -x "${build_dir}/zed"
  strip -x "${build_dir}/cli"
fi

cp "${build_dir}/zed" "${app_path}/Contents/MacOS/zed"
cp "${build_dir}/cli" "${app_path}/Contents/MacOS/cli"

rm -rf "${app_path}/Contents/Frameworks"
mkdir -p "${app_path}/Contents/Frameworks"

echo "Downloading git binary"
download_git "${app_path}/Contents/MacOS/git"

echo "Ad-hoc signing ${app_path}"
codesign --force --deep --entitlements "${entitlements_path}" --sign - "${app_path}" -v

bundle_name="$(basename "${app_path}")"

if [[ "${local_install}" == true ]]; then
  rm -rf "/Applications/${bundle_name}"
  mv "${app_path}" "/Applications/${bundle_name}"
  echo "Installed application bundle: /Applications/${bundle_name}"
  if [[ "${open_result}" == true ]]; then
    open "/Applications/${bundle_name}"
  fi
  exit 0
fi

if [[ "${target_dir}" == "debug" ]]; then
  echo "Debug build detected - skipping DMG creation"
  echo "Created application bundle: ${app_path}"
  if [[ "${open_result}" == true ]]; then
    open "${app_path}"
  fi
  exit 0
fi

dmg_source_directory="${build_dir}/dmg"
dmg_file_path="${build_dir}/Zed-${arch_suffix}.dmg"

rm -rf "${dmg_source_directory}"
mkdir -p "${dmg_source_directory}"
mv "${app_path}" "${dmg_source_directory}/"
ln -s /Applications "${dmg_source_directory}/Applications"

echo "Creating DMG at ${dmg_file_path}"
hdiutil create -volname Zed -srcfolder "${dmg_source_directory}" -ov -format UDZO "${dmg_file_path}"

rm "${dmg_source_directory}/Applications"

echo "Created ${dmg_file_path}"
echo "Application bundle: ${dmg_source_directory}/${bundle_name}"

if [[ "${open_result}" == true ]]; then
  open "${build_dir}"
fi
